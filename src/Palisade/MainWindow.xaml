<Window x:Class="Palisade.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Palisade — Windows 11 hardening wizard"
        Width="1020" Height="680" MinWidth="880" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBackgroundBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        Icon="/Assets/palisade.ico">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="252" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Left rail -->
        <Border Grid.Column="0" Padding="22,26,18,20" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal">
                    <Border Width="38" Height="38" CornerRadius="9" Background="{StaticResource AccentBrush}">
                        <TextBlock Text="🛡" FontSize="19" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Palisade" FontSize="19" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                        <TextBlock Text="Windows hardening" FontSize="11" Foreground="{StaticResource SubtleTextBrush}" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Row="1" Margin="0,30,0,0">
                    <ItemsControl x:Name="StepsList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,7" Height="24">
                                    <Ellipse Width="20" Height="20" VerticalAlignment="Center">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="Transparent" />
                                                <Setter Property="Stroke" Value="{StaticResource BorderBrush}" />
                                                <Setter Property="StrokeThickness" Value="1.5" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                        <Setter Property="Fill" Value="{StaticResource AccentBrush}" />
                                                        <Setter Property="Stroke" Value="{StaticResource AccentBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsDone}" Value="True">
                                                        <Setter Property="Stroke" Value="{StaticResource AccentBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <TextBlock Text="{Binding Number}" FontSize="11" TextAlignment="Center"
                                               Width="20" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource SubtleTextBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                        <Setter Property="Foreground" Value="White" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="{Binding Title}" Margin="32,0,0,0" VerticalAlignment="Center" FontSize="13">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource SubtleTextBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                                                        <Setter Property="FontWeight" Value="SemiBold" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border Margin="0,18,0,0" BorderThickness="0,1,0,0" BorderBrush="{StaticResource BorderBrush}" />

                    <Button x:Name="RollbackNavButton" Style="{StaticResource LinkButton}"
                            Content="↩  Roll back changes &amp; logs" Margin="-4,12,0,0"
                            HorizontalAlignment="Left" Click="RollbackNav_Click" />
                </StackPanel>

                <StackPanel Grid.Row="2">
                    <TextBlock x:Name="VersionText" FontSize="11" Foreground="{StaticResource SubtleTextBrush}" />
                    <TextBlock Text="Open source · MIT" FontSize="11" Foreground="{StaticResource SubtleTextBrush}" Margin="0,2,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Content -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <ContentControl x:Name="PageHost" Grid.Row="0" Margin="30,26,30,8" />

            <Border x:Name="Footer" Grid.Row="1" Padding="30,12"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
                <Grid>
                    <Button x:Name="BackButton" Content="← Back" HorizontalAlignment="Left"
                            Visibility="Collapsed" Click="Back_Click" />
                    <Button x:Name="NextButton" Style="{StaticResource AccentButton}" Content="Get started →"
                            HorizontalAlignment="Right" MinWidth="150" Click="Next_Click" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
