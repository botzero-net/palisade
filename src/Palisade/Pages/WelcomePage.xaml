<UserControl x:Class="Palisade.Pages.WelcomePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <TextBlock Style="{StaticResource PageTitle}" Text="Take back your Windows." />
        <TextBlock Style="{StaticResource PageSubtitle}"
                   Text="Palisade walks you through the privacy and security choices Windows setup should have offered — every change explained before it happens, journaled, and reversible." />

        <Border Style="{StaticResource Card}" Margin="0,26,0,0">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                    <TextBlock Text="🔒" FontSize="20" VerticalAlignment="Center" />
                    <StackPanel Margin="12,0,0,0">
                        <TextBlock Text="Private by design" FontWeight="SemiBold" FontSize="14" />
                        <TextBlock Text="Palisade never phones home — no accounts, no telemetry, no installers. It only sets documented Windows policies, registry values and services."
                                   Foreground="{StaticResource SubtleTextBrush}" TextWrapping="Wrap" FontSize="12.5" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                    <TextBlock Text="📋" FontSize="20" VerticalAlignment="Center" />
                    <StackPanel Margin="12,0,0,0">
                        <TextBlock Text="Explainable" FontWeight="SemiBold" FontSize="14" />
                        <TextBlock Text="Each protection lists the exact setting it changes — the same knobs an administrator would set by hand."
                                   Foreground="{StaticResource SubtleTextBrush}" TextWrapping="Wrap" FontSize="12.5" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="↩" FontSize="20" VerticalAlignment="Center" />
                    <StackPanel Margin="12,0,0,0">
                        <TextBlock Text="Reversible" FontWeight="SemiBold" FontSize="14" />
                        <TextBlock Text="Every run is journaled with the previous values, so you can roll back a change — or a whole session — anytime."
                                   Foreground="{StaticResource SubtleTextBrush}" TextWrapping="Wrap" FontSize="12.5" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Margin="0,18,0,0" Padding="14" CornerRadius="8"
                Background="{StaticResource WarnSoftBrush}" BorderBrush="#F0D9B5" BorderThickness="1">
            <TextBlock FontSize="12.5" Foreground="{StaticResource WarnBrush}" TextWrapping="Wrap">
                Run only on a machine you administer. Palisade needs administrator rights and will ask via UAC.
                Designed for Windows 11 — most protections also work on Windows 10.
            </TextBlock>
        </Border>
    </StackPanel>
</UserControl>
