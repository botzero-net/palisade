<UserControl x:Class="Palisade.Pages.ResultsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <TextBlock Style="{StaticResource PageTitle}" Text="All done." />
        <TextBlock Style="{StaticResource PageSubtitle}"
                   Text="Your changes are journaled — you can roll them back individually or all at once, now or later." />

        <Border Style="{StaticResource Card}" Margin="0,22,0,0">
            <StackPanel Orientation="Horizontal">
                <StackPanel Margin="0,0,40,0">
                    <TextBlock x:Name="AppliedCount" FontSize="26" FontWeight="SemiBold"
                               Foreground="{StaticResource GoodBrush}" />
                    <TextBlock Text="protections applied" FontSize="12" Foreground="{StaticResource SubtleTextBrush}" />
                </StackPanel>
                <StackPanel Margin="0,0,40,0">
                    <TextBlock x:Name="AlreadyCount" FontSize="26" FontWeight="SemiBold" />
                    <TextBlock Text="already in place" FontSize="12" Foreground="{StaticResource SubtleTextBrush}" />
                </StackPanel>
                <StackPanel Margin="0,0,40,0">
                    <TextBlock x:Name="SkippedCount" FontSize="26" FontWeight="SemiBold"
                               Foreground="{StaticResource SubtleTextBrush}" />
                    <TextBlock Text="not applicable" FontSize="12" Foreground="{StaticResource SubtleTextBrush}" />
                </StackPanel>
                <StackPanel>
                    <TextBlock x:Name="FailedCount" FontSize="26" FontWeight="SemiBold"
                               Foreground="{StaticResource BadBrush}" />
                    <TextBlock Text="failed" FontSize="12" Foreground="{StaticResource SubtleTextBrush}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <Border x:Name="RebootBanner" Style="{StaticResource Card}" Margin="0,12,0,0"
                Background="{StaticResource WarnSoftBrush}" BorderBrush="#F0D9B5" Visibility="Collapsed">
            <TextBlock Foreground="{StaticResource WarnBrush}" FontSize="12.5" TextWrapping="Wrap"
                       Text="⚠ At least one change needs a restart to take full effect. Reboot when convenient." />
        </Border>

        <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
            <Button Content="Open log folder" Click="OpenLog_Click" />
            <Button Content="Roll back changes" Click="Rollback_Click" Margin="8,0,0,0" />
        </StackPanel>

        <TextBlock x:Name="LogPathText" Margin="0,14,0,0" FontSize="11.5"
                   Foreground="{StaticResource SubtleTextBrush}" TextWrapping="Wrap" />
    </StackPanel>
</UserControl>
