<UserControl x:Class="Palisade.Pages.ChoicesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Style="{StaticResource PageTitle}" Text="Choose your protections" />
            <TextBlock Style="{StaticResource PageSubtitle}"
                       Text="Recommended items are pre-selected. Expand any item to see exactly what it changes. " />
            <StackPanel Orientation="Horizontal" Margin="0,14,0,12">
                <Button Content="Recommended" Click="SelectRecommended_Click" />
                <Button Content="All" Click="SelectAll_Click" Margin="8,0,0,0" />
                <Button Content="None" Click="SelectNone_Click" Margin="8,0,0,0" />
                <TextBlock x:Name="CountText" VerticalAlignment="Center" Margin="16,0,0,0"
                           Foreground="{StaticResource SubtleTextBrush}" FontSize="12.5" />
                <TextBlock x:Name="DetectingText" VerticalAlignment="Center" Margin="12,0,0,0"
                           Foreground="{StaticResource SubtleTextBrush}" FontSize="12" />
            </StackPanel>
        </StackPanel>

        <ListBox x:Name="ItemsList" Grid.Row="1" BorderThickness="0" Background="Transparent"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="0,0,0,8" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <ContentPresenter />
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.GroupStyle>
                <GroupStyle>
                    <GroupStyle.HeaderTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}" Style="{StaticResource SectionHeader}"
                                       Margin="0,14,0,8" />
                        </DataTemplate>
                    </GroupStyle.HeaderTemplate>
                </GroupStyle>
            </ListBox.GroupStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource Card}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                      VerticalAlignment="Top" Margin="0,2,12,0" />
                            <StackPanel Grid.Column="1">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Tweak.Title}" FontWeight="SemiBold"
                                               FontSize="13.5" VerticalAlignment="Center" />
                                    <Border Style="{StaticResource RecommendedBadge}"
                                            Visibility="{Binding RecommendedBadgeVisibility}">
                                        <TextBlock Style="{StaticResource BadgeText}"
                                                   Foreground="{StaticResource AccentPressedBrush}"
                                                   Text="Recommended" />
                                    </Border>
                                    <Border Style="{StaticResource Badge}">
                                        <TextBlock Style="{StaticResource BadgeText}"
                                                   Text="{Binding StateText}"
                                                   Foreground="{Binding StateBrush}" />
                                    </Border>
                                    <Border Style="{StaticResource Badge}" Background="{StaticResource WarnSoftBrush}"
                                            Visibility="{Binding RebootBadgeVisibility}">
                                        <TextBlock Style="{StaticResource BadgeText}"
                                                   Foreground="{StaticResource WarnBrush}"
                                                   Text="Restart needed" />
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="{Binding Tweak.Description}" FontSize="12.5"
                                           Foreground="{StaticResource SubtleTextBrush}"
                                           TextWrapping="Wrap" Margin="0,3,0,0" />
                                <Expander Header="What this changes" Margin="0,8,0,0">
                                    <StackPanel Margin="4,6,0,0">
                                        <TextBlock Text="{Binding Tweak.Details}" FontSize="12"
                                                   Foreground="{StaticResource SubtleTextBrush}"
                                                   TextWrapping="Wrap" />
                                        <ItemsControl ItemsSource="{Binding ActionDescriptions}" Margin="0,8,0,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding}" FontFamily="Consolas" FontSize="11.5"
                                                               Foreground="{StaticResource SubtleTextBrush}"
                                                               Margin="0,1.5" TextWrapping="Wrap" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Expander>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>
