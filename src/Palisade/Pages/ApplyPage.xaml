<UserControl x:Class="Palisade.Pages.ApplyPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <TextBlock Style="{StaticResource PageTitle}" Text="Applying your choices" />
        <TextBlock x:Name="SubtitleText" Style="{StaticResource PageSubtitle}" Text="Working…" />

        <ProgressBar x:Name="Progress" Margin="0,20,0,16" Minimum="0" Maximum="100" />

        <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="380">
            <ItemsControl x:Name="Rows">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="26" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Glyph}" Foreground="{Binding GlyphBrush}"
                                       FontSize="14" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding Title}" FontSize="13" />
                                <TextBlock Text="{Binding Detail}" FontSize="11.5"
                                           Foreground="{StaticResource SubtleTextBrush}"
                                           Visibility="{Binding DetailVisibility}" />
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="{Binding StatusText}" FontSize="12"
                                       Foreground="{StaticResource SubtleTextBrush}"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </StackPanel>
</UserControl>
